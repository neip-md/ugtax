*.pdf
steuern_*/
classification_review.yaml

# --- ERiC SDK -----------------------------------------------------------------
# The ELSTER ERiC SDK is ~2 GB of proprietary binaries from the Bayerisches
# Landesamt für Steuern. It is licensed to the developer, not redistributable,
# and must never be committed - least of all to a public repository. Download it
# from the ELSTER developer portal into ./eric/ locally.
# eric/README.md is kept so the directory can document how to obtain the SDK.
eric/*
!eric/README.md
*.dylib
*.so
*.dll
ERiC-*/

# --- os ---------------------------------------------------------------------
.DS_Store

# ============================================================================
# PRIVATE / AGENT STATE - never track
#
# The checkout lives in its own directory, never at $HOME, so a broad
# `git add -A` cannot reach past the project. That is the real fix; these
# rules are the backstop, enforced by scripts/repo-guard.sh via git hooks
# and CI.
# ============================================================================

# AI agent state (instructions, memory, wiki, MCP config, transcripts)
.claude/
.claude.json
.claude.json.backup
.claude-worktrees/
.mcp.json
.gstack/
.brain/
.wiki/
.openclaw/
.codex/
.letta/
.cursor/
memory/
.citation_cache_orchestrator.json

# Supabase CLI local state (holds project refs and local service keys)
.supabase/

# Credentials, keys, tokens
.env
.env.*
!.env.example
!.env.local.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
