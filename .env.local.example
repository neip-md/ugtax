# --- Supabase (auth + profile persistence) -------------------------------
# From your neip Supabase project: Settings -> API.
# Both are safe to expose to the browser (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Leave the two vars unset to run UGtax exactly as before — fully client-side,
# no accounts. Auth UI hides itself automatically when they are absent.

# --- LLM classification (optional) -----------------------------------------
# No key belongs here. The Anthropic, OpenAI or Google key for the optional
# classification fallback is entered per session in the UI, held for that one
# request, and never written to disk or to this file.
