#!/usr/bin/env bash
#
# Inspects exactly what a push would send and aborts if it carries private
# paths, secret material, or confidential business content.
#
# Install:  scripts/install-hooks.sh   (sets core.hooksPath=.githooks)
# Audit:    .githooks/pre-push --audit [<range>]   (default origin/main..HEAD)
# Bypass:   git push --no-verify       (only for a verified false positive)
#
# Note: hooks are local and bypassable. The authoritative gate is the
# security-scan job in .github/workflows/security-scan.yml, which runs the same
# scanner in CI where --no-verify does not exist.
set -uo pipefail

ROOT=$(git rev-parse --show-toplevel)
GUARD="$ROOT/scripts/repo-guard.sh"
Z40="0000000000000000000000000000000000000000"

if [ "${1:-}" = "--audit" ]; then
  exec "$GUARD" --range "${2:-origin/main..HEAD}"
fi

remote_name="${1:-origin}"
violations=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$Z40" ] && continue                       # branch deletion
  if [ "$remote_sha" = "$Z40" ]; then                         # new branch
    commits=$(git rev-list "$local_sha" --not --remotes="$remote_name" 2>/dev/null)
  else
    commits=$(git rev-list "${remote_sha}..${local_sha}" 2>/dev/null)
  fi
  [ -z "$commits" ] && continue
  "$GUARD" --commits "$commits" || violations=1
done

if [ "$violations" -ne 0 ]; then
  printf '\n\033[31mPUSH ABORTED by .githooks/pre-push - nothing was sent.\033[0m\n' >&2
  printf 'Remove the offending content from these commits and try again.\n' >&2
  printf 'Only if you are certain it is a false positive:  git push --no-verify\n' >&2
  exit 1
fi
exit 0
